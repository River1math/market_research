# Copy to .env and fill in.
DATABASE_URL="file:./dev.db"

# Public base URL of the app, used for Stripe redirect URLs.
APP_URL="http://localhost:3000"

# Stripe (test mode keys). The webhook secret comes from `stripe listen`.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Optional: a pre-created one-time Price for the $79 Single. If empty, the
# checkout route sends inline price_data instead.
STRIPE_PRICE_SINGLE=""

# DeepSeek (OpenAI-compatible API). Leave the key empty to run in mock mode:
# answers are then copied from your best-matching security fact, no API calls.
DEEPSEEK_API_KEY=""
# Optional overrides.
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
